// Antigravity Brain - Configuración Global Optimizada
// Versión 2.0 - Multi-agente + MCP + Orquestación Paralela
// IMPORTANTE: Reiniciar Antigravity IDE después de modificar este archivo.
{
	// ── Renderizado ──────────────────────────────────────────────────
	// "disable-hardware-acceleration": true,

	// ── Crash Reporting ──────────────────────────────────────────────
	"enable-crash-reporter": false,
	"crash-reporter-id": "0a5fdc1e-7144-4c1a-a902-9494eef7efc6",

	// ── Telemetría (DESACTIVADA - Privacy First) ─────────────────────
	"disable-telemetry": true,

	// ── Configuración Multi-Agente ────────────────────────────────────
	// Número máximo de agentes ejecutándose en paralelo
	"max-parallel-agents": 3,

	// Agentes disponibles
	"agents": [
		{
			"id": "react-component-specialist",
			"name": "React Component Specialist",
			"skills": ["create-feature"],
			"priority": 1
		},
		{
			"id": "test-guardian",
			"name": "Test Guardian",
			"skills": ["test-suite"],
			"priority": 2,
			"min-coverage": 85
		},
		{
			"id": "ruthless-code-reviewer",
			"name": "Ruthless Code Reviewer",
			"skills": ["refactor-code"],
			"priority": 3
		}
	],

	// ── Orquestación ─────────────────────────────────────────────────
	"orchestration": {
		"mode": "parallel",
		"require-review-before-merge": true,
		"require-tests-before-merge": true,
		"min-test-coverage": 85,
		"block-on-eslint-errors": true
	},

	// ── MCP Integrations ─────────────────────────────────────────────
	"mcp": {
		"firecrawl": {
			"enabled": true,
			"api-key-env": "FIRECRAWL_API_KEY"
		},
		"supabase": {
			"enabled": true,
			"url-env": "SUPABASE_URL",
			"key-env": "SUPABASE_ANON_KEY"
		},
		"github-actions": {
			"enabled": true,
			"auto-verify-before-merge": true,
			"artifacts": true
		}
	},

	// ── Sandbox ───────────────────────────────────────────────────────
	"sandbox": {
		"strict": true,
		"block-direct-main-push": true,
		"require-pr": true,
		"environments": ["local", "staging", "production"]
	},

	// ── Brain Path ────────────────────────────────────────────────────
	"brain-path": "${HOME}/.antigravity",
	"rules-path": "${HOME}/.antigravity/rules/rules.md",
	"skills-path": "${HOME}/.antigravity/skills"
}